<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  DirectoryIndex index.html

  # Do not rewrite root index.html
  RewriteRule ^index\.html$ - [L]

  # If requesting a directory that has an index.html, serve that index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # If requesting path without slash matching blog/:slug, serve blog/:slug/index.html if exists
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]

  # Otherwise fallback to root index.html for SPA
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api [NC]
  RewriteRule . /index.html [L]
</IfModule>
